# Copy this file to .env for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead
# (never upload a real .env file to GitHub).

# Postgres connection string from Neon, Supabase, or Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Paystack API keys (from your Paystack dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"
